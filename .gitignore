# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Environments
.env
.venv
env/
venv/
ENV/

# Database files
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Uploaded documents and storage (keep directory structure)
storage/documents/*
!storage/documents/.gitkeep
storage/synthetic_images/*
!storage/synthetic_images/.gitkeep

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/

# Distribution / packaging
dist/
build/
*.egg-info/

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Local scratch, tools, and temporary live links
scratch/
tools/
LIVE_ONLINE_LINK.txt

# Local backups and exports (strictly excluded from git for security)
var/
var/backups/*
!var/backups/.gitkeep
var/exports/*
!var/exports/.gitkeep

# Temporary media workspaces & raw footage
ashik/video/
public/


