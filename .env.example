# ====================================================================
# SME Finance Copilot - Environment Configuration (Example)
# ====================================================================

# Application Environment
ENVIRONMENT=development
APP_NAME="SME Finance Copilot"
DEBUG=true
LOG_LEVEL=INFO

# Server Configuration
HOST=127.0.0.1
PORT=8000

# Database Configuration (Local-first SQLite by default; ready for PostgreSQL)
# Local SQLite format: sqlite:///./sme_finance.db
# PostgreSQL format: postgresql+psycopg2://user:password@localhost:5432/sme_finance
DATABASE_URL=sqlite:///./sme_finance.db
DB_ECHO=false

# Security & Session (Replace with secure random key in production)
SECRET_KEY=sme_copilot_dev_secret_key_change_in_production_32bytes_minimum
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Storage Paths
STORAGE_DIR=./storage
DOCUMENTS_STORAGE_PATH=./storage/documents
SYNTHETIC_DATA_PATH=./storage/synthetic_data

# Currency & Financial Settings
DEFAULT_CURRENCY=BDT
DEFAULT_MINOR_UNIT_MULTIPLIER=100

# ML & OCR Engine Configuration
OCR_ENGINE=rapidocr_mock_fallback
MODEL_REGISTRY_PATH=./storage/model_registry
MAX_UPLOAD_SIZE_BYTES=10485760
